# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/socialpulse
DATABASE_URL=

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Full public URL of the app (no trailing slash)
# Example: https://comments.tudominio.com
NEXTAUTH_URL=

# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Facebook / Meta OAuth ────────────────────────────────────────────────────
# App credentials from https://developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Scopes requested at LOGIN (identity only — never page permissions here).
# "email" is not available in Business-type Meta apps (Invalid Scopes error).
FACEBOOK_LOGIN_SCOPES=public_profile

# Scopes requested when CONNECTING a Page (OAuth flow in /accounts).
# pages_manage_engagement is required to reply to / delete / hide comments;
# until Meta approves it in App Review, only users with a role in the Meta app
# (admin/developer/tester) get it granted.
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_read_user_content,pages_manage_engagement,business_management

# Page-connect OAuth flow (same Meta app as login)
FACEBOOK_PAGES_APP_ID=
FACEBOOK_PAGES_APP_SECRET=
# {NEXTAUTH_URL}/api/accounts/callback
FACEBOOK_PAGES_REDIRECT_URI=

# Token used to verify Meta webhook subscriptions (you choose this value)
META_WEBHOOK_VERIFY_TOKEN=

# ─── Encryption ───────────────────────────────────────────────────────────────
# 64-character hex key used to encrypt page tokens and OpenAI keys at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── AI provider (OpenAI) ─────────────────────────────────────────────────────
# There is intentionally NO global AI API key here. The app uses OpenAI
# (model gpt-4o-mini) with a PER-TENANT key: each tenant sets its own OpenAI
# key in the dashboard (/settings), stored AES-256-GCM encrypted on
# Tenant.openaiApiKey and decrypted per-request. Do not add ANTHROPIC_API_KEY
# or OPENAI_API_KEY — they are not read.

# ─── Public app metadata ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=Lionscore

# ─── Redis (BullMQ job queue) ─────────────────────────────────────────────────
# Example: redis://localhost:6379  |  with password: redis://:password@localhost:6379
REDIS_URL=
